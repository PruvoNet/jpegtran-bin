{
  "name": "jpegtran-bin",
  "version": "7.2.1",
  "description": "jpegtran (part of libjpeg-turbo) wrapper that makes it seamlessly available as a local dependency",
  "license": "MIT",
  "repository": "PruvoNet/jpegtran-bin",
  "author": {
    "name": "Sindre Sorhus",
    "email": "sindresorhus@gmail.com",
    "url": "sindresorhus.com"
  },
  "maintainers": [
    {
      "name": "Kevin Mårtensson",
      "email": "kevinmartensson@gmail.com",
      "url": "github.com/kevva"
    },
    {
      "name": "Shinnosuke Watanabe",
      "url": "github.com/shinnn"
    }
  ],
  "type": "module",
  "exports": "./index.js",
  "bin": {
    "jpegtran": "cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "binary": {
    "host": "https://github.com",
    "remote_path": "PruvoNet/jpegtran-bin/releases/download/v{version}"
  },
  "scripts": {
    "postinstall": "node lib/install.js",
    "test": "ava --timeout=180s"
  },
  "files": [
    "index.js",
    "cli.js",
    "lib",
    "vendor/source"
  ],
  "keywords": [
    "imagemin",
    "compress",
    "image",
    "img",
    "jpeg",
    "jpg",
    "minify",
    "optimize",
    "jpegtran"
  ],
  "dependencies": {
    "bin-build": "^3.0.0"
  },
  "devDependencies": {
    "ava": "^6.0.0",
    "tempy": "^3.0.0"
  }
}
